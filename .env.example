# Secure Live Tracker - Environment Configuration Template
# Copy this file to .env and replace secrets before production deployment.

# Core Security
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# Public Production Base URL (Must be your live HTTPS domain)
# Example: https://secure-live-tracker.example.com
PUBLIC_BASE_URL=https://secure-live-tracker.example.com

# Database Connection (SQLite local fallback, or PostgreSQL for production)
# Example PostgreSQL: postgresql://user:password@localhost:5432/secure_tracker
DATABASE_URL=sqlite:///database/secure_tracker.db

# Administrator Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePass!2026
ADMIN_EMAIL=admin@securetracker.local

# Geolocation Provider (default: ip-api, does not require an API key)
GEOLOCATION_PROVIDER=ip-api
GEOLOCATION_API_KEY=

# Data Retention Policy (Days before visit logs become eligible for auto-purge)
DEFAULT_RETENTION_DAYS=90

# Cookie Security (Set to True when running directly behind HTTPS in production)
SESSION_COOKIE_SECURE=False
